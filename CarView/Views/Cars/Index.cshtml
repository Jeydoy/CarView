@model IEnumerable<CarView.Models.Car>

@{
    ViewData["Title"] = "Каталог автомобілів";
}

<div class="container-xl mt-4 mb-5 text-white">
    <div class="row">
        
        <!-- ==================== ЛІВА ЧАСТИНА: СПИСОК АВТО ==================== -->
        <div class="col-lg-9 order-2 order-lg-1">
            
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-2">
                <h2 class="text-info m-0">Каталог автомобілів <span class="text-secondary fs-5">(@Model.Count())</span></h2>
                <!-- Кнопку "Додати авто" ми звідси успішно прибрали -->
            </div>

            @if (!Model.Any())
            {
                <div class="alert bg-dark border-secondary text-center text-white py-5">
                    <h4 class="text-secondary mb-3">За вашим запитом нічого не знайдено</h4>
                    <a asp-action="Index" class="btn btn-info">Скинути фільтри</a>
                </div>
            }

            @foreach (var car in Model)
            {
                <!-- Картка авто -->
                <div class="card bg-dark border-secondary mb-4 shadow-sm position-relative" style="transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 15px rgba(0,0,0,0.5)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                    
                    <!-- КНОПКА ЛАЙКУ (Абсолютно позиційована зверху справа) -->
                    @{
                        var likedCars = ViewBag.LikedCars as List<string> ?? new List<string>();
                        bool isLiked = likedCars.Contains(car.Id.ToString());
                    }
                    <form asp-action="ToggleLike" asp-route-id="@car.Id" method="post" class="position-absolute" style="top: 75px; right: 20px; z-index: 10;">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-dark rounded-circle shadow-lg border border-secondary p-2 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: rgba(33,37,41,0.85);" title="Додати в улюблені">
                            <span class="fs-4" style="line-height: 1;">@(isLiked ? "❤️" : "🤍")</span>
                        </button>
                    </form>

                    <!-- Тіло картки (клікабельне) -->
                    <a asp-action="Details" asp-route-id="@car.Id" class="text-decoration-none text-white d-block">
                        <div class="row g-0">
                            
                            <!-- ФОТО -->
                            <div class="col-md-4 col-sm-5">
                                @{
                                    // Залежно від того, як названа твоя колонка в базі: IsMain чи IsMainPoster
                                    var mainPhoto = car.MediaFiles?.FirstOrDefault(m => m.IsMain)?.FileUrl 
                                                 ?? car.MediaFiles?.FirstOrDefault()?.FileUrl;
                                }
                                @if (!string.IsNullOrEmpty(mainPhoto))
                                {
                                    <img src="@mainPhoto.Replace("\"", "").Trim()" class="img-fluid rounded-start" alt="@car.ModelName" style="object-fit: cover; height: 240px; width: 100%;">
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-secondary rounded-start" style="height: 240px; width: 100%;">
                                        <span class="text-dark fw-bold">Немає фото</span>
                                    </div>
                                }
                            </div>
                            
                            <!-- ДЕТАЛІ -->
                            <div class="col-md-8 col-sm-7">
                                <div class="card-body d-flex flex-column h-100 p-4">
                                    
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h3 class="card-title text-info fw-bold mb-1">
                                                @(car.Brand != null ? car.Brand.Name : "") @car.ModelName
                                            </h3>
                                            <p class="text-secondary mb-0">Рік випуску: @car.Year</p>
                                        </div>
                                        <h3 class="text-success fw-bold m-0 text-end" style="white-space: nowrap;">
                                            $@car.Price.ToString("N0")
                                        </h3>
                                    </div>

                                    <!-- Значки з характеристиками (Білий текст) -->
                                    <div class="row mt-auto g-2">
                                        <div class="col-6 col-md-3">
                                            <div class="p-2 border border-secondary rounded text-center shadow-sm" style="background-color: rgba(255,255,255,0.05);">
                                                <div class="text-secondary mb-1" style="font-size: 0.8rem;">⚙️ Двигун</div>
                                                <div class="fw-bold fs-6 text-white">@(string.IsNullOrEmpty(car.EngineCapacity) ? "-" : car.EngineCapacity)</div>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="p-2 border border-secondary rounded text-center shadow-sm" style="background-color: rgba(255,255,255,0.05);">
                                                <div class="text-secondary mb-1" style="font-size: 0.8rem;">🐎 Потужність</div>
                                                <div class="fw-bold fs-6 text-white">@(car.HorsePower > 0 ? $"{car.HorsePower} к.с." : "-")</div>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="p-2 border border-secondary rounded text-center shadow-sm" style="background-color: rgba(255,255,255,0.05);">
                                                <div class="text-secondary mb-1" style="font-size: 0.8rem;">🕹️ КПП</div>
                                                <div class="fw-bold fs-6 text-white" style="font-size: 0.9rem;">@car.Transmission</div>
                                            </div>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <div class="p-2 border border-secondary rounded text-center shadow-sm" style="background-color: rgba(255,255,255,0.05);">
                                                <div class="text-secondary mb-1" style="font-size: 0.8rem;">⛽ Паливо</div>
                                                <div class="fw-bold fs-6 text-white" style="font-size: 0.9rem;">@car.FuelType</div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <!-- ==================== ПРАВА ЧАСТИНА: ФІЛЬТРИ ==================== -->
        <div class="col-lg-3 order-1 order-lg-2 mb-4">
            <div class="card bg-dark border-secondary shadow-lg sticky-top" style="top: 80px; z-index: 1; max-height: calc(100vh - 100px); overflow-y: auto;">
                <div class="card-header border-secondary bg-transparent pt-3 pb-2">
                    <h5 class="text-info m-0">🔍 Пошук та фільтри</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Index" method="get">
                        
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Пошук за назвою</label>
                            <input type="text" name="searchString" class="form-control bg-dark text-white border-secondary" placeholder="Наприклад, M5" value="@ViewBag.CurrentSearch">
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary small">Марка авто</label>
                            <select name="brandId" class="form-select bg-dark text-white border-secondary" asp-items="ViewBag.BrandList">
                                <option value="">Всі марки</option>
                            </select>
                        </div>

                    <!-- ІНТЕРАКТИВНІ ПОВЗУНКИ ЦІНИ (ВІД і ДО) -->
<div class="mb-4 bg-dark border border-secondary rounded p-3" style="background-color: rgba(255,255,255,0.02) !important;">
    <label class="form-label text-white fw-bold small w-100 border-bottom border-secondary pb-2 mb-3">Діапазон ціни ($)</label>
    
    <!-- Повзунок ВІД -->
    <div class="d-flex justify-content-between align-items-end mb-1">
        <span class="text-secondary" style="font-size: 0.85rem;">Від:</span>
        <span class="text-info fw-bold fs-6">$<span id="minPriceValue">@((ViewBag.MinPrice ?? 1000).ToString("N0"))</span></span>
    </div>
    <input type="range" name="minPrice" class="form-range mb-3" 
           min="1000" max="10000000" step="1000" 
           value="@(ViewBag.MinPrice ?? 1000)" 
           oninput="document.getElementById('minPriceValue').innerText = Number(this.value).toLocaleString('en-US')">
    
    <!-- Повзунок ДО -->
    <div class="d-flex justify-content-between align-items-end mb-1">
        <span class="text-secondary" style="font-size: 0.85rem;">До:</span>
        <span class="text-info fw-bold fs-6">$<span id="maxPriceValue">@((ViewBag.MaxPrice ?? 10000000).ToString("N0"))</span></span>
    </div>
    <input type="range" name="maxPrice" class="form-range" 
           min="1000" max="10000000" step="1000" 
           value="@(ViewBag.MaxPrice ?? 10000000)" 
           oninput="document.getElementById('maxPriceValue').innerText = Number(this.value).toLocaleString('en-US')">
</div>

                        <div class="mb-3 border-bottom border-secondary pb-3">
                            <label class="form-label text-secondary small">Рік випуску</label>
                            <div class="d-flex gap-2">
                                <input type="number" name="minYear" class="form-control bg-dark text-white border-secondary" placeholder="Від" value="@ViewBag.MinYear">
                                <input type="number" name="maxYear" class="form-control bg-dark text-white border-secondary" placeholder="До" value="@ViewBag.MaxYear">
                            </div>
                        </div>

                        <h6 class="text-info mt-3 mb-2">Характеристики</h6>
                        
                        <div class="mb-3">
                            <label class="form-label text-secondary small">Тип кузова</label>
                            <select name="bodyType" class="form-select bg-dark text-white border-secondary">
                                <option value="">Всі типи</option>
                                @foreach (var item in Html.GetEnumSelectList<CarView.Models.BodyType>())
                                {
                                    <option value="@item.Value" selected="@(ViewBag.BodyType?.ToString() == item.Value)">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary small">Коробка передач</label>
                            <select name="transmission" class="form-select bg-dark text-white border-secondary">
                                <option value="">Будь-яка</option>
                                @foreach (var item in Html.GetEnumSelectList<CarView.Models.Transmission>())
                                {
                                    <option value="@item.Value" selected="@(ViewBag.Transmission?.ToString() == item.Value)">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary small">Вид палива</label>
                            <select name="fuelType" class="form-select bg-dark text-white border-secondary">
                                <option value="">Будь-яке</option>
                                @foreach (var item in Html.GetEnumSelectList<CarView.Models.FuelType>())
                                {
                                    <option value="@item.Value" selected="@(ViewBag.FuelType?.ToString() == item.Value)">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary small">Привід (Трансмісія)</label>
                            <input type="text" name="drivetrain" class="form-control bg-dark text-white border-secondary" placeholder="Напр. AWD або 4Matic" value="@ViewBag.Drivetrain">
                        </div>

                        <button type="submit" class="btn btn-info w-100 fw-bold text-dark mb-2 shadow-sm">Застосувати фільтр</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Скинути всі</a>
                    </form>
                </div>
            </div>
        </div>
        
    </div>
</div>