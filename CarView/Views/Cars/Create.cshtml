@model CarView.ViewModels.CarCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<h4>Car</h4>
<hr />

<style>
.draggable-item {
    cursor: grab;
    width: 190px;
    height: 125px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid #444;
    background-color: #212529;
    user-select: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
}
.draggable-item:hover:not(.dragging) {
    transform: scale(1.04);
}
.draggable-item:active {
    cursor: grabbing;
}
.draggable-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
}
.draggable-item.dragging {
    opacity: 0.3;
    border: 2px dashed #0dcaf0;
}
</style>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Car.BrandId" class="control-label">Бренд</label>
                <select asp-for="Car.BrandId" class="form-select" id="brandSelect">
                    <option value="">-- Почніть вводити назву... --</option>
                </select>
                <span asp-validation-for="Car.BrandId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Car.ModelName" class="control-label"></label>
                <input asp-for="Car.ModelName" class="form-control" />
                <span asp-validation-for="Car.ModelName" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Car.Year" class="control-label"></label>
                    <input asp-for="Car.Year" class="form-control" />
                    <span asp-validation-for="Car.Year" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Car.Price" class="control-label"></label>
                    <input asp-for="Car.Price" class="form-control" />
                    <span asp-validation-for="Car.Price" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Car.BodyType" class="control-label"></label>
                    <input asp-for="Car.BodyType" class="form-control" />
                    <span asp-validation-for="Car.BodyType" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Car.Transmission" class="control-label"></label>
                    <input asp-for="Car.Transmission" class="form-control" />
                    <span asp-validation-for="Car.Transmission" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Car.FuelType" class="control-label"></label>
                    <input asp-for="Car.FuelType" class="form-control" />
                    <span asp-validation-for="Car.FuelType" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Car.HorsePower" class="control-label"></label>
                    <input asp-for="Car.HorsePower" class="form-control" placeholder="612" />
                    <span asp-validation-for="Car.HorsePower" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Car.Drivetrain" class="control-label"></label>
                    <input asp-for="Car.Drivetrain" class="form-control" placeholder="Повний (AWD)" />
                    <span asp-validation-for="Car.Drivetrain" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Car.EngineCapacity" class="control-label"></label>
                    <input asp-for="Car.EngineCapacity" class="form-control" placeholder="4.0 V8 BiTurbo" />
                    <span asp-validation-for="Car.EngineCapacity" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Car.Description" class="control-label"></label>
                <textarea asp-for="Car.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Car.Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="UploadedFile" class="control-label">Головне фото (Постер)</label>
                <input asp-for="UploadedFile" type="file" class="form-control" accept="image/*" id="posterInput" />
                <span asp-validation-for="UploadedFile" class="text-danger"></span>

                <img id="posterPreview" src="#" alt="Прев'ю постера" style="display:none; max-width: 250px; margin-top: 15px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.2);" />
            </div>
            <div class="form-group mb-4">
                <label asp-for="AdditionalFiles" class="control-label">Додаткові фото (Галерея)</label>
                <input asp-for="AdditionalFiles" type="file" multiple class="form-control" accept="image/*" id="galleryInput" />
                <span asp-validation-for="AdditionalFiles" class="text-danger"></span>

                <div id="galleryPreviewContainer" class="d-flex flex-wrap gap-2 mt-3"></div>
            </div>

            <div class="form-group mb-5 pb-5">
                <input type="submit" value="Створити авто" class="btn btn-primary px-4 shadow" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Назад до списку</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // 1. SELECT2 ДЛЯ БРЕНДІВ
        jQuery(document).ready(function ($) {
            $('#brandSelect').select2({
                placeholder: '-- Почніть вводити назву... --',
                minimumInputLength: 3,
                width: '100%', 
                ajax: {
                    url: '@Url.Action("SearchBrands", "Cars")',
                    dataType: 'json',
                    delay: 300,
                    data: function (params) {
                        return { term: params.term };
                    },
                    processResults: function (data) {
                        return { results: data };
                    },
                    cache: true
                }
            });
        });

        // 2. ПРЕВ'Ю ГОЛОВНОГО ФОТО (ПОСТЕРА)
        const posterInput = document.getElementById('posterInput');
        if (posterInput) {
            posterInput.addEventListener('change', function(event) {
                const file = event.target.files[0]; 
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const preview = document.getElementById('posterPreview');
                        if (preview) {
                            preview.src = e.target.result; 
                            preview.style.display = 'block'; 
                        }
                    };
                    reader.readAsDataURL(file);
                }
            });
        }


       //  DRAG-N-DROP ДЛЯ ГАЛЕРЕЇ
const fileInput = document.getElementById('galleryInput');
const container = document.getElementById('galleryPreviewContainer');
let selectedFiles = [];
let draggedEl = null;

if (fileInput && container) {

    fileInput.addEventListener('change', function (e) {
        container.querySelectorAll('img').forEach(img => URL.revokeObjectURL(img.src));

        selectedFiles = Array.from(e.target.files).filter(f => f.type.startsWith('image/'));
        renderPreviews();
    });

    function renderPreviews() {
        container.innerHTML = '';

        selectedFiles.forEach((file, index) => {
            const div = document.createElement('div');
            div.className = 'draggable-item';
            div.draggable = true;
            div.dataset.index = index;

            const img = document.createElement('img');
            img.src = URL.createObjectURL(file);
            img.alt = file.name;
            img.title = file.name;

            div.appendChild(img);
            container.appendChild(div);
        });
    }

    container.addEventListener('dragstart', (e) => {
        const item = e.target.closest('.draggable-item');
        if (!item) return;
        draggedEl = item;
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', item.dataset.index); 
        setTimeout(() => item.classList.add('dragging'), 0);
    });

    container.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!draggedEl) return;

        const target = e.target.closest('.draggable-item');
        if (!target || target === draggedEl) return;

        const box = target.getBoundingClientRect();
        const isAfter = e.clientX > box.left + box.width / 2;

        if (isAfter) {
            container.insertBefore(draggedEl, target.nextSibling);
        } else {
            container.insertBefore(draggedEl, target);
        }
    });

    container.addEventListener('drop', (e) => e.preventDefault());

    container.addEventListener('dragend', () => {
        if (!draggedEl) return;
        draggedEl.classList.remove('dragging');
        draggedEl = null;
        updateFileInputOrder();
    });

    function updateFileInputOrder() {
        const newOrder = [...container.querySelectorAll('.draggable-item')]
            .map(el => selectedFiles[parseInt(el.dataset.index)]);

        selectedFiles = newOrder;

        const dt = new DataTransfer();
        selectedFiles.forEach(f => dt.items.add(f));
        fileInput.files = dt.files;

        container.querySelectorAll('.draggable-item').forEach((el, i) => {
            el.dataset.index = i;
        });
    }
}
    </script>
}
