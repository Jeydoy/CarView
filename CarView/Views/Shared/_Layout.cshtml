<!DOCTYPE html>
<html lang="en">
<head>
    <style>
       html{
scroll-behavior: smooth;
       }
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | CarView - Каталог цікавих авто</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3JVKT9HY16"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-3JVKT9HY16');
    </script>

    <!-- Динамічний опис-->
    @if (ViewData["MetaDescription"] != null)
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
    }
    else
    {
        <meta name="description" content="Каталог найкращих автомобілів світу. Огляди, ціни, характеристики та розташування на мапі." />
    }

    @if (ViewData["MetaKeywords"] != null)
    {
        <meta name="keywords" content="@ViewData["MetaKeywords"]" />
    }
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarView.styles.css" asp-append-version="true" />
</head>
<body class="text-white">
    <header>
       <nav class="navbar navbar-dark bg-dark border-bottom border-info sticky-top">
    <div class="container-fluid">
      <button class="btn btn-dark border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu" aria-controls="offcanvasMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <!-- Логотип по центру -->
        <a class="navbar-brand mx-auto text-info fw-bold fs-4" asp-controller="Home" asp-action="Index">CarView</a>
        
        <!-- Блок кнопок справа  -->
<div class="d-flex align-items-center position-relative z-3">
    
    <!-- Сердечко -->
    <a asp-area="" asp-controller="Cars" asp-action="Favorites" class="btn btn-dark rounded-circle border-secondary d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 42px; height: 42px; background-color: rgba(30, 30, 30, 0.8); transition: all 0.2s;" onmouseover="this.style.backgroundColor='rgba(50, 50, 50, 0.9)'; this.style.boxShadow='0 0 10px rgba(220, 53, 69, 0.5)';" onmouseout="this.style.backgroundColor='rgba(30, 30, 30, 0.8)'; this.style.boxShadow='none';" title="Обране">
        <span style="font-size: 1.2rem; line-height: 1;">❤️</span> 
    </a>

    @if (User?.Identity?.IsAuthenticated == true)
    {
        <!-- Вихід (через AccountsController) -->
        <form class="m-0" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-right"></i> Вихід
            </button>
        </form>
    }
    else
    {
        <!-- Вхід (через AccountsController) -->
      
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#loginModal">
                            Увійти
                        </button>
    }
</div>
    </div>
</nav>

<div class="offcanvas offcanvas-start text-bg-dark" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title text-info fw-bold" id="offcanvasMenuLabel">Меню CarView</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="navbar-nav justify-content-end flex-grow-1 pe-3 mt-2">
            <li class="nav-item mb-2">
                <a class="nav-link fs-5" asp-controller="Home" asp-action="Index">🏠 Головна сторінка</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link fs-5" asp-controller="Cars" asp-action="Index">🚗 Каталог авто</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link fs-5 text-info" asp-controller="Brands" asp-action="Index">🏢 Авто компанії</a>
        <div style="margin-bottom: 15px;">
<li class="nav-item mb-2">
    <a class="nav-link fs-5 text-white" asp-area="" asp-controller="Cars" asp-action="Map">🗺️ Мапа</a>
</li>
            
            <li class="nav-item mt-4 pt-3 border-top border-secondary">
                <a class="nav-link fs-5 text-danger fw-bold" asp-controller="Cars" asp-action="Favorites">❤️ Лайкані авто</a>
            </li>
<li><hr class="border-secondary my-3" style="opacity: 0.3;"></li>

<li class="nav-item px-3 mb-2">
    <small class="text-white-50 text-uppercase fw-bold" style="letter-spacing: 1px;">Додатково</small>
</li>

<li class="nav-item mb-2">
    <a class="nav-link text-light fs-5" asp-controller="Home" asp-action="About" style="transition: color 0.2s;">
        ℹ️ Інформація про сайт
    </a>
</li>

<li class="nav-item mb-2">
    <a class="nav-link fs-5 fw-bold" asp-controller="Home" asp-action="Donation" style="color: #28a745; transition: opacity 0.2s;">
        ☕ Підтримка автора
    </a>
</li>
        </ul>
    </div>
</div>

<div class="offcanvas offcanvas-start text-bg-dark" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title text-info fw-bold" id="offcanvasMenuLabel">Меню CarView</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="navbar-nav justify-content-end flex-grow-1 pe-3 mt-2">
            <li class="nav-item mb-2">
                <a class="nav-link fs-5" asp-controller="Home" asp-action="Index">🏠 Головна сторінка</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link fs-5" asp-controller="Cars" asp-action="Index">🚗 Каталог авто</a>
            </li>
            <li class="nav-item mb-2">
                <a class="nav-link fs-5 text-info" asp-controller="Brands" asp-action="Index">🏢 Авто компанії</a>
            </li>
        </ul>
    </div>
</div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CarView - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
           
        </div>
    </div>
            <!-- Модальне вікно авторизації -->
            <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-dark text-white" style="border: 1px solid #444;">
                        <div class="modal-header border-secondary">
                            <h5 class="modal-title fw-bold" id="loginModalLabel">Авторизація в CarView</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center py-4">
                            <p class="mb-4">Увійдіть через обліковий запис Google, щоб ставити лайки </p>

                            <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Google" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                                <button type="submit" class="btn btn-light fw-bold px-4 py-2 rounded">
                                    <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" width="20" class="me-2">
                                    Продовжити з Google
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
</body>
</html>
