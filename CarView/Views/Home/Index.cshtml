@model CarView.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Головна";
}

<!-- (Hero Section) -->
@if (Model.HeroCar != null)
{
    <div class="position-relative overflow-hidden mb-5"
    style="height: 65vh; width: 100vw; margin-left: calc(-50vw + 50%);">

        <!-- Фонове відео -->
        <video autoplay loop muted playsinline class="position-absolute top-50 start-50 translate-middle w-100"
        style="object-fit: cover; min-height: 100%; z-index: 0;">
            <source src="~/videos/main-promo.mp4" type="video/mp4" />
        </video>

        <div class="position-absolute top-0 start-0 w-100 h-100"
        style="background-color: rgba(0, 0, 0, 0.3); z-index: 1;"></div>

        <!-- Контент поверх відео -->
        <div class="position-relative z-2 d-flex flex-column justify-content-center align-items-center h-100 text-center">
            @if (Model.HeroCar != null)
            {
                <!-- text-opacity-75 робить букви напівпрозорими -->
                <h1 class="mb-3 display-2 fw-bold text-info text-opacity-75">@Model.HeroCar.Brand.Name @Model.HeroCar.ModelName</h1>

                <!-- text-opacity-50 робить цей текст ще прозорішим -->
                <h4 class="mb-4 text-light text-opacity-50">Топ вибір цього тижня</h4>

                <!-- opacity: 0.8 додає прозорості самій кнопці -->
                <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.HeroCar.Id"
                class="btn btn-outline-info btn-lg px-5 py-3 fw-bold rounded-pill shadow" style="opacity: 0.8;">
                    Дізнатися більше
                </a>
            }
            else
            {
                <h1 class="mb-3 display-3 fw-bold text-info text-opacity-75">Каталог преміум авто</h1>
                <p class="lead text-light text-opacity-50">Знайди свій ідеальний автомобіль</p>
            }
        </div>
    </div>
}

<!--  Горизонтальний список інших машин -->
<div class="container-fluid mb-5 position-relative" style="padding: 0 70px;">
    <h3 class="mb-4" style="color: #fff;">Інші авто</h3>

    <style>
        .car-card-hover {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .car-card-hover:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 25px rgba(13, 202, 240, 0.2) !important;
        }
        /* Приховуємо стандартний скролбар */
        .hide-scroll {
            -ms-overflow-style: none;  /* IE та Edge */
            scrollbar-width: none;  /* Firefox */
        }
        .hide-scroll::-webkit-scrollbar {
            display: none; /* Chrome, Safari та Opera */
        }
        /* Фірмові блакитні стрілки */
        .scroll-btn {
            width: 45px; 
            height: 45px; 
            border-radius: 50%; 
            background-color: #0dcaf0; 
            color: #121212; 
            border: none; 
            font-size: 20px; 
            font-weight: bold;
            display: flex; 
            align-items: center; 
            justify-content: center;
            box-shadow: 0 0 15px rgba(13, 202, 240, 0.4);
            transition: all 0.2s;
            cursor: pointer;
        }
        .scroll-btn:hover {
            transform: scale(1.1);
            background-color: #0bb5d8;
            box-shadow: 0 0 20px rgba(13, 202, 240, 0.7);
        }
    </style>

   
    <button id="btnScrollLeft" class="scroll-btn position-absolute start-0 top-50 translate-middle-y z-3" style="margin-left: 10px;">
        &#10094;
    </button>

 
    <div id="carsScrollWrapper" class="d-flex flex-nowrap overflow-auto pb-4 gap-4 hide-scroll" style="scroll-snap-type: x mandatory;">
        
        @foreach (var car in Model.SimpleCars)
        {
            var carImage = car.MediaFiles?.FirstOrDefault(m => m.IsMain)?.FileUrl 
                           ?? car.MediaFiles?.FirstOrDefault()?.FileUrl 
                           ?? "/images/placeholder.jpg";

            <div class="col" style="min-width: 300px; scroll-snap-align: start;"> 
                <div class="card h-100 bg-dark text-white border-0 shadow car-card-hover" style="border-radius: 12px; overflow: hidden; background: linear-gradient(145deg, #1e1e1e, #292929);">
                    
                    <img src="@carImage" class="card-img-top w-100" alt="Фото авто" style="height: 200px; object-fit: cover; object-position: center;">
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold" style="color: #0dcaf0;">@car.Brand.Name @car.ModelName</h5>
                        
                        <p class="card-text mb-4">
                            <span class="text-white-50">@car.Year р. • </span>
                            <span class="fw-bold" style="color: #28a745;">$@car.Price.ToString("N0")</span>
                        </p>
                        
                        <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-info mt-auto fw-bold">Огляд</a>
                    </div>
                </div>
            </div>
        }
        
    </div>

 
    <button id="btnScrollRight" class="scroll-btn position-absolute end-0 top-50 translate-middle-y z-3" style="margin-right: 10px;">
        &#10095;
    </button>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const scrollWrapper = document.getElementById('carsScrollWrapper');
        const btnLeft = document.getElementById('btnScrollLeft');
        const btnRight = document.getElementById('btnScrollRight');

        // Ширина прокрутки (приблизно ширина однієї картки + відступ)
        const scrollAmount = 324; 

        btnLeft.addEventListener('click', () => {
            scrollWrapper.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        });

        btnRight.addEventListener('click', () => {
            scrollWrapper.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        });
    });
</script>

<!-- КОНТЕЙНЕР ДЛЯ ГРИ  -->
<div style="position: relative; width: 100%; max-width: 1200px; margin: 40px auto; border-radius: 16px; overflow: hidden; box-shadow: 0 15px 30px rgba(0,0,0,0.6);">
    
    <canvas id="driftCanvas" width="1200" height="600" style="display: block; width: 100%; height: auto; background-color: #1e293b; border-bottom: 4px solid #0f172a;"></canvas>
    <div id="gameMenu" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 10;">
        <h2 style="color: #f8fafc; font-size: 3.5rem; margin-bottom: 10px; text-shadow: 0 4px 10px rgba(0,0,0,0.5);">CarView Drift</h2>
        <p style="color: #94a3b8; margin-bottom: 40px; font-size: 1.2rem;">Керування: стрілочки ⬆️⬇️⬅️➡️. Дрифти, щоб заробляти очки!</p>

        <button id="playBtn" style="padding: 15px 50px; font-size: 1.5rem; font-weight: 800; color: #fff; background: linear-gradient(to right, #f43f5e, #e11d48); border: none; border-radius: 40px; cursor: pointer; box-shadow: 0 6px 15px rgba(225, 29, 72, 0.5); transition: all 0.2s; text-transform: uppercase;">
            Start Engine
        </button>
        <script>
   
    function trackGameStart() {
        if (typeof gtag !== 'undefined') {
            gtag('event', 'start_drift_game', {
                'event_category': 'Engagement',
                'event_label': 'Гравець запустив дрифт'
            });
            console.log("Analytics: Custom event sent!"); 
        }
    }
</script>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const canvas = document.getElementById('driftCanvas');
        const ctx = canvas.getContext('2d');
        const menu = document.getElementById('gameMenu');
        const playBtn = document.getElementById('playBtn');

        let isPlaying = false;
        let animationId;
        let score = 0;

        const carState = { x: 600, y: 300, vx: 0, vy: 0, angle: -Math.PI / 2, color: '#ef4444' };
        const keys = {};
        let skidmarks = [];

        const cones = [];
        const coneRadius = 8;
        for (let i = 0; i < Math.PI * 2; i += Math.PI / 2) {
            cones.push({ x: 400 + Math.cos(i) * 180, y: 300 + Math.sin(i) * 180, r: coneRadius });
        }
        for (let i = 0; i < Math.PI * 2; i += Math.PI / 2) {
            cones.push({ x: 800 + Math.cos(i) * 180, y: 300 + Math.sin(i) * 180, r: coneRadius });
        }

        playBtn.addEventListener('mouseover', () => playBtn.style.transform = 'scale(1.05) translateY(-2px)');
        playBtn.addEventListener('mouseout', () => playBtn.style.transform = 'scale(1) translateY(0)');

        window.addEventListener('keydown', (e) => {
            if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key) && isPlaying) {
                e.preventDefault();
            }
            keys[e.key] = true;
        });
        window.addEventListener('keyup', (e) => keys[e.key] = false);

        playBtn.addEventListener('click', () => {
            carState.x = 600;
            carState.y = 300;
            carState.vx = 0;
            carState.vy = 0;
            carState.angle = -Math.PI / 2;
            skidmarks = [];
            score = 0;

            isPlaying = true;
            menu.style.display = 'none';
            update();
        });

        function update() {
            if (!isPlaying) return;

           
            const engineForce = 0.08; 
            const friction = 0.99;    
            const turnSpeed = 0.065;  
            const maxSpeed = 5.5;     

            if (keys['ArrowUp']) {
                carState.vx += Math.cos(carState.angle) * engineForce;
                carState.vy += Math.sin(carState.angle) * engineForce;
            }
            if (keys['ArrowDown']) {
                carState.vx -= Math.cos(carState.angle) * engineForce * 0.7;
                carState.vy -= Math.sin(carState.angle) * engineForce * 0.7;
            }

            const speed = Math.sqrt(carState.vx ** 2 + carState.vy ** 2);

            if (speed > maxSpeed) {
                carState.vx = (carState.vx / speed) * maxSpeed;
                carState.vy = (carState.vy / speed) * maxSpeed;
            }

            if (speed > 0.5) {
                const handling = turnSpeed * (1 - (speed / maxSpeed) * 0.2);
                if (keys['ArrowLeft']) carState.angle -= handling;
                if (keys['ArrowRight']) carState.angle += handling;
            }

            carState.x += carState.vx;
            carState.y += carState.vy;
            carState.vx *= friction;
            carState.vy *= friction;

            const carRadius = 12;
            for (let cone of cones) {
                let dx = carState.x - cone.x;
                let dy = carState.y - cone.y;
                let distance = Math.sqrt(dx * dx + dy * dy);

                if (distance < carRadius + cone.r) {
                    carState.vx *= -0.5;
                    carState.vy *= -0.5;
                    carState.x += (dx / distance) * 4;
                    carState.y += (dy / distance) * 4;

                    score = Math.max(0, score - 50);
                }
            }

            if (carState.x < 0) carState.x = canvas.width;
            if (carState.x > canvas.width) carState.x = 0;
            if (carState.y < 0) carState.y = canvas.height;
            if (carState.y > canvas.height) carState.y = 0;

            const velocityAngle = Math.atan2(carState.vy, carState.vx);
            let angleDiff = Math.abs(velocityAngle - carState.angle);
            while (angleDiff > Math.PI) angleDiff -= Math.PI * 2;
            angleDiff = Math.abs(angleDiff);

          
          
            if (speed > 1.5 && angleDiff > 0.2) {
                skidmarks.push({ x: carState.x, y: carState.y, life: 1.0 });

           
                let driftPoints = Math.floor(speed * angleDiff * 1.5);
                score += driftPoints;
            }

     
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#f97316';
            for (let cone of cones) {
                ctx.beginPath();
                ctx.arc(cone.x, cone.y, cone.r, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 2;
                ctx.stroke();
            }

            for (let i = skidmarks.length - 1; i >= 0; i--) {
                let mark = skidmarks[i];
                ctx.fillStyle = `rgba(0, 0, 0, ${mark.life * 0.6})`;
                ctx.beginPath();
                ctx.arc(mark.x, mark.y, 6, 0, Math.PI * 2);
                ctx.fill();
                mark.life -= 0.006;
                if (mark.life <= 0) skidmarks.splice(i, 1);
            }

            ctx.save();
            ctx.translate(carState.x, carState.y);
            ctx.rotate(carState.angle);

            ctx.fillStyle = carState.color;
            ctx.shadowColor = 'rgba(0,0,0,0.6)';
            ctx.shadowBlur = 10;
            ctx.shadowOffsetY = 5;
            ctx.fillRect(-18, -10, 36, 20);

            ctx.shadowBlur = 0;
            ctx.shadowOffsetY = 0;
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(2, -8, 8, 16);
            ctx.fillRect(-12, -8, 4, 16);

            ctx.fillStyle = '#fef08a';
            ctx.fillRect(16, -9, 3, 4);
            ctx.fillRect(16, 5, 3, 4);

            ctx.fillStyle = '#ef4444';
            ctx.fillRect(-18, -9, 2, 4);
            ctx.fillRect(-18, 5, 2, 4);

            ctx.restore();

            ctx.fillStyle = '#f8fafc';
            ctx.font = 'bold 28px "Segoe UI", sans-serif';
            ctx.textAlign = 'left';
            ctx.shadowColor = 'rgba(0,0,0,0.8)';
            ctx.shadowBlur = 4;
            ctx.fillText(`🔥 DRIFT SCORE: ${score}`, 30, 50);
            ctx.shadowBlur = 0;

            animationId = requestAnimationFrame(update);
        }
    });
</script>

<!-- 3. Запрошення в меню -->
<div class="container my-5">
    <div class="p-5 text-center bg-dark text-white border-0" style="border-radius: 20px; box-shadow: 0 10px 30px rgba(13, 202, 240, 0.15);">
        
        <h2 class="fw-bold mb-3" style="color: #0dcaf0;">Шукаєте щось конкретне?</h2>
        
        <p class="fs-5 text-white-50 mb-4">Використовуйте зручні фільтри за маркою, кузовом, роком та ціною.</p>
        
        <a asp-controller="Cars" asp-action="Index" class="btn btn-info btn-lg fw-bold px-5 py-3 shadow" style="border-radius: 30px; color: #121212; transition: all 0.3s ease;">
            Перейти до повного каталогу ➔
        </a>
        
    </div>
</div>