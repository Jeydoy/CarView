@{
    ViewData["Title"] = "Підтримати автора";
}

<div class="d-flex align-items-center justify-content-center py-5" style="min-height: calc(100vh - 160px);">
    <div class="card border-0 shadow-lg text-center" style="background-color: #1e2125; border-radius: 20px; max-width: 550px; width: 100%;">
        <div class="card-body p-5">
            
            <h2 class="fw-bold mb-4" style="color: #0dcaf0;">Сподобався проєкт?</h2>
            
            <p class="text-white-50 mb-4" style="line-height: 1.6;">
                Ваша підтримка допомагає нам оплачувати хостинг SmarterASP та додавати нові круті тачки у каталог.<br/>
                Оплата відбувається через безпечний шлюз Приват24 / LiqPay.
            </p>

            <form method="POST" action="https://www.liqpay.ua/api/3/checkout" accept-charset="utf-8">
                <input type="hidden" name="data" value="@ViewBag.LiqPayData" />
                <input type="hidden" name="signature" value="@ViewBag.LiqPaySignature" />

                <button type="submit" class="btn btn-lg btn-success fw-bold px-4 py-3 shadow" style="border-radius: 12px; transition: 0.3s;">
                    ☕ Підтримати через Приват24
                </button>
            </form>

        </div>
    </div>
</div>